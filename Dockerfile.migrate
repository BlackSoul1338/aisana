FROM docker.io/library/node:20-alpine

RUN apk add --no-cache openssl
WORKDIR /app

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@12.17.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY prisma ./prisma

# Он нужен демо-сиду: он импортирует код из src/ (scoreFields)
COPY src ./src

RUN pnpm exec prisma generate

# prisma migrate deploy — применяет только закоммиченные миграции из prisma/migrations,
# ничего не удаляет и не «синхронизирует» молча (в отличие от db push --accept-data-loss).
#
# Первый запуск на СУЩЕСТВУЮЩЕЙ базе (созданной раньше через db push):
# deploy упадёт с P3005 («база не пустая») — только в этом случае помечаем
# baseline 0_init как уже применённую (resolve --applied) и повторяем deploy.
# Любая другая ошибка (права, сеть, pgcrypto) — выходим без baseline:
# иначе на свежей или чужой базе можно пометить 0_init применённой без таблиц.
# На свежей базе deploy просто применит 0_init и создаст схему.
CMD sh -c " \
  echo '⏳ Applying migrations (prisma migrate deploy)...' && \
  if ! out=$(pnpm exec prisma migrate deploy 2>&1); then \
    echo \"$out\"; \
    case \"$out\" in \
      *P3005*) \
        echo '⚠️  База не пустая (P3005) — baselining 0_init и повтор deploy...' && \
        pnpm exec prisma migrate resolve --applied 0_init && \
        pnpm exec prisma migrate deploy ;; \
      *) \
        echo '❌ Deploy упал не из-за P3005 — baseline не делаем, чтобы не испортить базу.'; \
        exit 1 ;; \
    esac; \
  fi && \
  echo '🌱 Running seed (regions + technologies + admin only)...' && \
  pnpm exec tsx prisma/seed.ts && \
  if [ "${SEED_DEMO:-0}" = '1' ]; then \
    echo '🌱 SEED_DEMO=1 — наполняем демо-данными (временный презентационный деплой)' && \
    pnpm exec tsx prisma/seed-demo.ts; \
  fi && \
  echo '✅ Migration & seed complete!' \
"
