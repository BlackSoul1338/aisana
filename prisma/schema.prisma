generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  password     String?
  role         UserRole    @default(VIEWER)
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  // Компания представителя бизнеса (BUSINESS_REP); у остальных ролей null
  organization String?
  image        String?
  // Когда пользователь последний раз вошёл; null — ни разу не входил
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  sessions     Session[]
  integrationRequests IntegrationRequest[]
  businessNeeds       BusinessNeed[]
  @@index([universityId])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("sessions")
}

enum UserRole {
  ADMIN
  EDITOR
  UNIVERSITY_REP
  VIEWER
  BUSINESS_REP   // представитель компании: витрина решений и запросы на внедрение
}

model Region {
  id           String       @id @default(cuid())
  name         String       @unique
  nameKz       String?
  code         String       @unique
  center       String?
  universities University[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@map("regions")
}

model University {
  id          String         @id @default(cuid())
  name        String
  nameKz      String?
  shortName   String?
  logo        String?
  regionId    String
  region      Region         @relation(fields: [regionId], references: [id])
  address     String?
  website     String?
  email       String?
  phone       String?
  rector      String?
  description String?        @db.Text
  type        UniversityType @default(STATE)
  users       User[]
  projects    Project[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@index([regionId])
  @@map("universities")
}

enum UniversityType {
  STATE
  PRIVATE
  NATIONAL
  RESEARCH
}

model Project {
  id            String          @id @default(cuid())
  title         String
  description   String          @db.Text
  universityId  String
  university    University      @relation(fields: [universityId], references: [id])
  leadName      String?
  leadEmail     String?
  teamSize      Int?
  launchDate    DateTime?
  category      ProjectCategory
  status        ProjectStatus   @default(IDEA)
  // Отрасль применения (не тип технологии — см. category). Заполняет вуз.
  industry      ProjectIndustry?
  // Где внедрено: организация или подразделение. Обязательно для вуза на
  // стадиях IMPLEMENTED и SCALED (см. lib/project-completeness).
  implementedAt String?         @db.Text
  technologies  Technology[]    @relation("ProjectTechnologies")
  isBestPractice Boolean        @default(false)
  isScalable    Boolean         @default(false)
  // Открыт для витрины интеграционных решений; ставит только модератор
  availableForIntegration Boolean @default(false)
  impact        String?         @db.Text
  results       String?         @db.Text

  // Legacy file fields (kept for compatibility)
  presentationPdf  String?
  presentationPptx String?
  agentPassportPdf String?   // URL to PDF passport
  zoomLink         String?
  videoUrl         String?
  screenshots      String[]
  documentation    String?

  // NEW: Project files (acts, presentations, links)
  files            ProjectFile[]

  // NEW: Statistics
  viewCount        Int            @default(0)
  searchHitCount   Int            @default(0)

  hearings         Hearing[]
  tags             String[]

  // Тематические направления, вычисленные классификатором (см. lib/search).
  // Пересчитываются при сохранении проекта и командой переиндексации.
  topics           ProjectTopic[]

  // Запросы бизнеса на демонстрацию, консультацию, пилот или внедрение
  integrationRequests IntegrationRequest[]

  // Модерация: на публичной части видны только PUBLISHED.
  // Представитель вуза создаёт черновик и отправляет на проверку,
  // публикует администратор или редактор.
  publication      PublicationStatus @default(PUBLISHED)
  submittedAt      DateTime?         // когда отправлен на проверку
  publishedAt      DateTime?         // когда опубликован
  moderationNote   String?           @db.Text  // комментарий модератора при возврате

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  @@index([universityId])
  @@index([status])
  @@index([category])
  @@index([industry])
  @@index([createdAt])
  @@index([publication])
  @@map("projects")
}

enum PublicationStatus {
  DRAFT      // черновик вуза, виден только автору и администраторам
  REVIEW     // отправлен на проверку
  PUBLISHED  // опубликован на портале
}

// ── Тематическая классификация проекта ────────────────────
// Один проект относится сразу к нескольким направлениям, у каждого
// свой коэффициент релевантности и объяснение, почему он туда попал.
model ProjectTopic {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic       String   // идентификатор направления из lib/search/taxonomy
  score       Int      // коэффициент релевантности 0–100
  explanation String   @db.Text
  signals     String[] // признаки, по которым сработала классификация
  updatedAt   DateTime @updatedAt

  @@unique([projectId, topic])
  @@index([topic])
  @@index([score])
  @@map("project_topics")
}

// ── Project Files ─────────────────────────────────────────
model ProjectFile {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        ProjectFileType
  label       String                       // Display name
  url         String                       // Link or path
  size        Int?                         // bytes
  createdAt   DateTime        @default(now())
  @@index([projectId])
  @@map("project_files")
}

enum ProjectFileType {
  ACT             // Акт внедрения
  PRESENTATION    // Презентация (PDF/PPTX)
  DOCUMENTATION   // Документация
  VIDEO           // Видео
  ZOOM            // Zoom запись
  LINK            // Внешняя ссылка
  OTHER           // Прочее
}

enum ProjectCategory {
  EDUCATION
  SCIENCE
  MANAGEMENT
  ANALYTICS
  GENERATIVE_AI
  COMPUTER_VISION
  ROBOTICS
}

enum ProjectIndustry {
  EDUCATION_SCIENCE
  HEALTHCARE
  FINANCE_BUSINESS
  INDUSTRY_MINING
  ENERGY
  AGRICULTURE
  TRANSPORT
  CONSTRUCTION
  IT_SECURITY
  GOVERNMENT
  LAW
  ECOLOGY
  CULTURE_TOURISM_SPORT
  SOCIAL
  OTHER
}

enum ProjectStatus {
  IDEA
  PROTOTYPE
  PILOT
  IMPLEMENTED
  SCALED
}

model Technology {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  projects Project[] @relation("ProjectTechnologies")
  @@map("technologies")
}

model Hearing {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date            DateTime
  commission      String[]
  remarks         String?         @db.Text
  recommendations String?         @db.Text
  decision        HearingDecision @default(PENDING)
  decisionText    String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@index([projectId])
  @@map("hearings")
}

enum HearingDecision {
  PENDING
  APPROVED
  REJECTED
  REVISION
  RECOMMENDED
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  action    String   // CREATE | UPDATE | DELETE | IMPORT
  entity    String   // project | university | user | hearing | passport | project_file | import...
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

// ── Кэш ответов ИИ ─────────────────────────────────────────
// Ответы модели стоят денег, поэтому храним их в базе: кэш переживает
// рестарт контейнера и одинаков на всех репликах приложения.
//
// В ключ входит хэш промпта: правка промпта в коде инвалидирует запись,
// иначе старые ответы показывались бы как актуальные.
model LlmCache {
  cacheKey   String   @id @map("cache_key")
  kind       String // 'summary' | 'reasons'
  payload    Json // точное тело ответа модели
  model      String
  promptHash String   @map("prompt_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("llm_cache")
}

// ── Обратная связь с портала ──────────────────────────────
model Feedback {
  id           String       @id @default(cuid())
  topic        FeedbackTopic @default(QUESTION)
  name         String
  email        String
  organization String?
  message      String       @db.Text
  status       FeedbackStatus @default(NEW)
  adminNote    String?      @db.Text
  createdAt    DateTime     @default(now())
  handledAt    DateTime?

  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}

enum FeedbackTopic {
  ACCESS_REQUEST // запрос доступа для вуза
  ADD_PROJECT    // предложить проект
  BUG            // ошибка на портале
  QUESTION       // общий вопрос
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  DONE
}

// ── Запросы бизнеса по решению ────────────────────────────
// Представитель компании просит демонстрацию, консультацию, пилот или
// внедрение. Запрос сначала разбирает оператор портала (ADMIN/EDITOR), потом
// передаёт его представителю вуза-разработчика. Прямых контактов бизнес не
// получает: связь идёт через оператора.
model IntegrationRequest {
  id             String                   @id @default(cuid())
  // Проект может быть не выбран (запрос из помощника подбора) или удалён вузом —
  // тогда оператор привязывает проект сам, прежде чем передать запрос вузу
  projectId      String?
  project        Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Контакт на момент создания: запрос переживает удаление учётки
  contactName    String?
  contactEmail   String
  organization   String?
  contactPhone   String?
  type           IntegrationRequestType
  message        String                   @db.Text
  status         IntegrationRequestStatus @default(NEW)
  operatorNote   String?                  @db.Text // видят только ADMIN/EDITOR
  universityNote String?                  @db.Text // ответ вуза, видят все участники
  // Когда оператор передал запрос вузу. Видимость для вуза решается по нему,
  // а не по статусу: отклонённый оператором до передачи запрос вуз не видит.
  forwardedAt    DateTime?
  // Потребность из помощника подбора, по которой создан запрос
  needId         String?
  need           BusinessNeed?            @relation(fields: [needId], references: [id], onDelete: SetNull)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([projectId])
  @@index([userId])
  @@map("integration_requests")
}

enum IntegrationRequestType {
  DEMO          // демонстрация
  CONSULTATION  // консультация
  PILOT         // пилот
  INTEGRATION   // внедрение
}

enum IntegrationRequestStatus {
  NEW                 // создан бизнесом
  IN_REVIEW           // разбирает оператор
  SENT_TO_UNIVERSITY  // передан вузу
  IN_PROGRESS         // вуз и компания на связи
  DONE                // завершён
  DECLINED            // отклонён оператором или вузом
}

// Потребность бизнеса, собранная в диалоге с помощником подбора (порт BCB из Sana).
// Диалог короткий (не больше MAX_TURNS ходов), поэтому всё хранится в одной строке.
model BusinessNeed {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     BusinessNeedStatus @default(COLLECTING)
  // Номер последнего хода; по нему же оптимистичная блокировка параллельных ходов
  turnCount  Int                @default(0)
  readiness  Int                @default(0)
  messages   Json               @default("[]") // [{ role, text }]
  fields     Json               @default("[]") // FieldState[] последнего хода
  snapshots  Json               @default("[]") // [{ turn, readiness }]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  integrationRequests IntegrationRequest[]

  @@index([userId, updatedAt])
  @@map("business_needs")
}

enum BusinessNeedStatus {
  COLLECTING // диалог идёт
  SENT       // отправлено оператору запросом
}
