# ── База данных ────────────────────────────────────────────
# Пароль Postgres. ВАЖНО: если volume с данными уже существует,
# смена этой переменной НЕ меняет пароль в самой БД — см. инструкцию по деплою.
POSTGRES_PASSWORD=your-strong-password

# Для локальной разработки вне Docker (npm run dev, prisma studio).
# Пароль должен совпадать с POSTGRES_PASSWORD выше.
DATABASE_URL="postgresql://postgres:your-strong-password@localhost:5432/ai_map_kz"

# ── Приложение ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Пароль админа, которого создаёт сид (prisma/seed.ts). Минимум 10 символов.
# Если переменная не задана — пароль генерируется случайный и печатается в лог сида.
ADMIN_PASSWORD=your-strong-admin-password

# ── Бэкапы ─────────────────────────────────────────────────
# Срок хранения журнала аудита в днях. По умолчанию не задан — старые записи
# не удаляются. Включать только после согласования срока с владельцем данных.
AUDIT_RETENTION_DAYS=

# ── Google Gemini API (ИИ-поиск) ───────────────────────────
# Ключи выдаёт https://aistudio.google.com/app/apikey
# Без ключа ИИ-поиск отвечает, но без пояснений модели.
GEMINI_API_KEY=

# Модели. Квота Free Tier: у flash — 20 запросов в сутки, у flash-lite — 500.
# GEMINI_MODEL        — сложные задачи (пояснения по проектам, JSON по схеме)
# GEMINI_MODEL_LITE   — простые задачи (краткое резюме): дешевле и быстрее
# GEMINI_MODEL_FALLBACKS — цепочка резервных моделей при исчерпанной квоте/перегрузке.
# Внимание: gemini-3.5-flash и gemini-3.6-flash делят ОДНУ квоту — ставить их
# рядом в цепочке бессмысленно. Доступность моделей зависит от ключа: перед
# выкаткой проверить curl .../v1beta/models?key= на своём ключе.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
