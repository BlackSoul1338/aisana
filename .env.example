# ── База данных ────────────────────────────────────────────
# Пароль Postgres. ВАЖНО: если volume с данными уже существует,
# смена этой переменной НЕ меняет пароль в самой БД — см. инструкцию по деплою.
POSTGRES_PASSWORD=your-strong-password

# Для локальной разработки вне Docker (npm run dev, prisma studio).
# Пароль должен совпадать с POSTGRES_PASSWORD выше.
DATABASE_URL="postgresql://postgres:your-strong-password@localhost:5432/ai_map_kz"

# ── Приложение ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Пароль админа, которого создаёт сид (prisma/seed.ts).
# Если переменная не задана — пароль генерируется случайный и печатается в лог сида.
ADMIN_PASSWORD=your-admin-password

# ── Google Gemini API (ИИ-поиск) ───────────────────────────
# Ключи выдаёт https://aistudio.google.com/app/apikey
# Без ключа ИИ-поиск отвечает, но без пояснений модели.
GEMINI_API_KEY=

# Модели. Квота Free Tier — 20 запросов в сутки НА КАЖДУЮ МОДЕЛЬ, и модели
# делятся на независимые «корзины»: кончилась квота у одной — у другой ещё есть.
#
# GEMINI_MODEL        — сложные задачи (пояснения по проектам, JSON по схеме)
# GEMINI_MODEL_LITE   — простые задачи (краткое резюме): дешевле и быстрее
# GEMINI_MODEL_FALLBACKS — цепочка резервных моделей, когда у основной
#                       исчерпана квота или она перегружена.
#
# Внимание: gemini-3.5-flash и gemini-3.6-flash делят ОДНУ квоту (запрос к
# 3.5-flash отвечает бэкендом 3.6-flash) — ставить их рядом в цепочке бессмысленно.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview
